{
  "permissions": {
    "allow": [],
    "deny": [
      "Bash(rm -f *)",
      "Bash(rm *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-credentials.sh",
            "timeout": 10,
            "statusMessage": "Checking for credentials..."
          }
        ]
      }
    ]
  }
}
